# ---- Nomos One / Logistiki Pro — αντιγράψτε σε .env και συμπληρώστε ----

# Δημόσια διεύθυνση (χρησιμοποιείται για CORS, links σε emails, Stripe redirects).
# Μόνο scheme://host[:port], χωρίς διαδρομή. Χωρίς έγκυρη τιμή (εδώ ή στις Ρυθμίσεις → public_url) οι υπενθυμίσεις
# στέλνονται χωρίς σύνδεσμο πληρωμής με κάρτα, και ο σύνδεσμος πρόσκλησης πύλης μένει σχετικός (/portal/<token>).
PUBLIC_URL=https://nomos.example.gr
PUBLIC_PORT=8080

# Βάση
DB_NAME=nomos_one
# Η MongoDB απαιτεί πλέον αυθεντικοποίηση. Χωρίς αυτήν, κάθε container στο δίκτυο και
# κάθε διεργασία στον host διάβαζε δεδομένα υπό δικηγορικό απόρρητο και αρχεία KYC/AML.
MONGO_USER=nomos
# ΠΡΕΠΕΙ να αλλάξει: η τιμή «change-me…» είναι δημόσια (βρίσκεται σε αυτό το αρχείο) και ο server ΑΡΝΕΙΤΑΙ να ξεκινήσει
# όσο υπάρχει στο MONGO_PASSWORD ή μέσα στο MONGO_URL. Παράγετε τιμή με:  openssl rand -base64 33
MONGO_PASSWORD=change-me-to-a-long-random-string
#
# ΑΝΑΒΑΘΜΙΣΗ ΥΠΑΡΧΟΥΣΑΣ ΕΓΚΑΤΑΣΤΑΣΗΣ: τα MONGO_INITDB_ROOT_* δημιουργούν χρήστη μόνο σε
# ΚΕΝΟ data directory. Αν έχετε ήδη δεδομένα, φτιάξτε τον χρήστη μία φορά χειροκίνητα:
#   docker compose exec mongo mongosh admin --eval \
#     'db.createUser({user:"nomos",pwd:"<MONGO_PASSWORD>",roles:[{role:"root",db:"admin"}]})'
# και μετά κάντε restart. Επαληθεύστε με:  docker compose logs backend | tail
#
# MONGO_URL=mongomock://                 # in-memory, μόνο για δοκιμές/demo

# Ασφάλεια
# ΠΡΕΠΕΙ να αλλάξει: με γνωστό JWT_SECRET ο καθένας υπογράφει δικό του token σύνδεσης (και δικαιώματα διαχειριστή). Ο server
# ΑΡΝΕΙΤΑΙ να ξεκινήσει όσο έχει την τιμή «change-me…» (το ίδιο ισχύει και για το MONGO_PASSWORD παραπάνω).
# Παράγετε τιμή με:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Κλειδί κρυπτογράφησης των αποθηκευμένων μυστικών (SMTP/IMAP passwords, subscription key ΑΑΔΕ).
# Παράγεται με: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Αν μείνει κενό, παράγεται από το JWT_SECRET — τότε η αλλαγή του JWT_SECRET καθιστά τα μυστικά
# μη αναγνώσιμα και πρέπει να ξανακαταχωρηθούν από τις Ρυθμίσεις.
SECRETS_KEY=
ADMIN_EMAIL=admin@logistiki.gr
# ADMIN_PASSWORD=                        # αν μείνει κενό, δημιουργείται τυχαίος και τυπώνεται στο log την 1η φορά
# CORS_ORIGINS=https://nomos.example.gr  # προαιρετικό — default το PUBLIC_URL
#
# Πότε στέλνει ο browser το cookie σύνδεσης σε αίτημα που ξεκινά από ΑΛΛΟΝ ιστότοπο: lax | strict | none (default lax).
# Η εγκατάσταση docker-compose είναι ίδιας προέλευσης (ο nginx σερβίρει και την εφαρμογή και το /api), οπότε το "lax" δεν
# κοστίζει τίποτα και είναι η πρώτη γραμμή άμυνας απέναντι σε πλαστά αιτήματα από άλλη σελίδα (CSRF). Το "none" χρειάζεται
# ΜΟΝΟ αν η εφαρμογή σερβίρεται από άλλο site από το API· τότε βάλτε και την προέλευση της εφαρμογής στο CORS_ORIGINS —
# η προστασία στηρίζεται πλέον μόνο στον έλεγχο προέλευσης του server (στα logs: «Απορρίφθηκε αίτημα … από ξένη προέλευση»).
# COOKIE_SAMESITE=lax

# Autopilot (αυτόματη λογιστική)
# Ο scheduler τρέχει στην υπηρεσία "worker" του docker-compose. Βάλτε 1 μόνο αν θέλετε
# να τον τρέχει το ίδιο το API (single-process εγκατάσταση χωρίς worker).
AUTOPILOT_SCHEDULER=0
BACKUP_DIR=/app/backups
AUTOPILOT_INTERVAL_MINUTES=15
# MYDATA_MOCK=0                          # 1 = προσομοίωση myDATA για demo (ΠΟΤΕ σε παραγωγή)

# Αρχεία (αποδείξεις, συνημμένα)
STORAGE_BACKEND=local                    # local | emergent
UPLOAD_DIR=/app/uploads

# AI (προαιρετικό — χωρίς κλειδί οι AI λειτουργίες επιστρέφουν 503, όλα τα υπόλοιπα δουλεύουν)
# EMERGENT_LLM_KEY=
# LLM_MODEL=gpt-5.4-mini

# Open banking (προαιρετικό — αυτόματες τραπεζικές κινήσεις μέσω PSD2)
# Λογαριασμός: https://bankaccountdata.gocardless.com — τα κλειδιά καταχωρούνται στις Ρυθμίσεις,
# όχι εδώ, ώστε να αποθηκεύονται κρυπτογραφημένα ανά γραφείο.

# Stripe (προαιρετικό — online πληρωμές & payment links στις υπενθυμίσεις)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MODE=test
